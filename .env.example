# .env.example
# Copie para .env e troque TODOS os valores "changeme" antes de subir:
#   cp .env.example .env
# O .env nunca vai para o git.

# --- Porta pública do sistema (a única exposta pelo docker compose) ---
# O sistema fica em http://<servidor>:APP_PORT
APP_PORT=8080

# --- MongoDB ---
# Use só letras e números na senha: ela entra na URL de conexão do backend.
MONGO_INITDB_ROOT_USERNAME=changeme
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=oportunidades_cefet

# --- Autenticação (JWT) ---
# Segredo com no mínimo 32 caracteres. Gere um com: openssl rand -base64 48
SECURITY_JWT_SECRET=changeme-use-um-segredo-longo-e-aleatorio-com-32-ou-mais
# Validade do token de acesso (24h) e do refresh token (7 dias), em milissegundos.
SECURITY_JWT_EXPIRATION_MS=86400000
SECURITY_JWT_REFRESH_EXPIRATION_MS=604800000

# --- Opcionais ---
# Origens liberadas no CORS. Com o nginx tudo sai da mesma origem, então "*" basta.
APP_CORS_ALLOWED_ORIGIN=*
# Nível de log das requisições no backend (INFO em produção, DEBUG para depurar).
BACKEND_LOG_LEVEL=INFO
# mongo-express (docker compose --profile tools up -d), preso ao localhost do servidor.
MONGO_EXPRESS_PORT=8081

# --- Só para desenvolvimento (docker-compose.dev.yml) ---
FRONTEND_PORT=4200
BACKEND_PORT=8090
FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1
