# .env.example
# Copie este arquivo para .env e preencha com valores reais antes de rodar `docker compose up`.

MONGO_INITDB_ROOT_USERNAME=changeme
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=oportunidades_cefet
MONGO_URI=mongodb://changeme:changeme@mongo:27017/oportunidades_cefet?authSource=admin
SPRING_DATA_MONGODB_DATABASE=oportunidades_cefet

SECURITY_JWT_SECRET=changeme-use-a-long-random-secret
SECURITY_JWT_EXPIRATION_MS=86400000

FRONTEND_PORT=4200
FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1
